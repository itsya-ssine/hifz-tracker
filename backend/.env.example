# --- Database (Turso) ---
# Use the https:// form of the URL (libsql:// is rewritten to https:// automatically).
# For local development without Turso you can use: file:./local.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- Cookies ---
# In production (HTTPS): COOKIE_SECURE=true
# If the frontend and API are on different sites, COOKIE_SAMESITE=none (requires COOKIE_SECURE=true)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173
